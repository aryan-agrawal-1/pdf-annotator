{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Annotation",
  "version": "0.1.0",
  "identifier": "com.local.pdfannotation",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Annotation",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
